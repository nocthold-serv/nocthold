# Plantilla de ajustes de una instancia. NO pongas contraseñas aquí:
# ./nocthold.sh crea prod.env y test.env a partir de esta plantilla, con
# contraseñas aleatorias, y esos dos ficheros nunca se suben a Git.
#
# Los valores con @@ los rellena el script según sea prod o test.

# --- Servidor ---
SERVER_NAME=@@SERVER_NAME@@
SERVER_IP=158.220.91.85
SERVER_LOCATION=EUR
TZ=Europe/Madrid

# Puertos públicos (prod 7171-7173 y 8088, pruebas 7271-7273 y 8188).
LOGIN_PORT=@@LOGIN_PORT@@
GAME_PORT=@@GAME_PORT@@
STATUS_PORT=@@STATUS_PORT@@
LOGIN_HTTP_PORT=@@LOGIN_HTTP_PORT@@

# Imagen del servidor: la nuestra, que GitHub Actions construye y sube en cada
# cambio de la rama (prod -> :prod, develop -> :develop). Ver README.
# La oficial de Canary, por si hiciera falta: ghcr.io/opentibiabr/canary:3.6.1
CANARY_IMAGE=ghcr.io/nocthold-serv/nocthold:@@RAMA@@
MAP_URL=https://github.com/opentibiabr/canary/releases/download/v3.6.1/otservbr.otbm

# --- Base de datos (solo accesible dentro de Docker) ---
DB_NAME=@@DB_NAME@@
DB_USER=nocthold
DB_PASSWORD=@@RANDOM@@
DB_ROOT_PASSWORD=@@RANDOM@@

# --- Web MyAAC (solo por túnel SSH) ---
MYAAC_PORT=@@MYAAC_PORT@@
MYAAC_ADMIN_ACCOUNT=admin
MYAAC_ADMIN_EMAIL=team.nocthold@gmail.com
MYAAC_ADMIN_PASSWORD=@@RANDOM@@
MYAAC_ADMIN_PLAYER=@@ADMIN_PLAYER@@
